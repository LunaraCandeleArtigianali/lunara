const CONFIG={spreadsheetId:'1thyOxCWPjYx0gQmiQH8ldZUOKGhGTLaV1xIi6TccmhU',tabs:['Anagrafica','Stock','Calcolo Costi','Vendite-Ricavi','KPIs'],readonlyTabs:['KPIs']};
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Lunara · Gestionale').addMetaTag('viewport','width=device-width,initial-scale=1');}
function getDashboard(){const ss=SpreadsheetApp.openById(CONFIG.spreadsheetId);return{name:ss.getName(),tabs:CONFIG.tabs.filter(n=>ss.getSheetByName(n)).map(n=>({name:n,rows:Math.max(0,ss.getSheetByName(n).getLastRow()-detect_(ss.getSheetByName(n)).headerRow),readonly:CONFIG.readonlyTabs.includes(n)}))};}
function getTabData(name){if(!CONFIG.tabs.includes(name))throw Error('Foglio non autorizzato');const sh=SpreadsheetApp.openById(CONFIG.spreadsheetId).getSheetByName(name),m=detect_(sh);if(!m.headerRow)return{name,headers:[],rows:[],editable:false};const nr=Math.min(250,Math.max(0,sh.getLastRow()-m.headerRow)),nc=sh.getLastColumn(),v=nr?sh.getRange(m.headerRow+1,1,nr,nc).getDisplayValues():[],f=nr?sh.getRange(m.headerRow+1,1,nr,nc).getFormulas():[];return{name,headers:m.headers.map((h,c)=>({name:h,index:c,editable:!CONFIG.readonlyTabs.includes(name)&&!f.some(r=>!!r[c])})),rows:v.map((r,i)=>({rowNumber:m.headerRow+i+1,values:r})).filter(r=>r.values.some(x=>x!=='')),editable:!CONFIG.readonlyTabs.includes(name)};}
function updateRow(name,row,changes){if(!CONFIG.tabs.includes(name)||CONFIG.readonlyTabs.includes(name))throw Error('Archivio in sola lettura');const sh=SpreadsheetApp.openById(CONFIG.spreadsheetId).getSheetByName(name),m=detect_(sh),locked=formulaCols_(sh,m);if(row<=m.headerRow||row>sh.getLastRow())throw Error('Riga non valida');const f=sh.getRange(row,1,1,sh.getLastColumn()).getFormulas()[0];Object.keys(changes).forEach(k=>{const c=m.headers.indexOf(k);if(c<0)throw Error('Colonna sconosciuta');if(locked[c]||f[c])throw Error('La colonna '+k+' contiene una formula ed è protetta');sh.getRange(row,c+1).setValue(value_(changes[k]));});SpreadsheetApp.flush();return{ok:true};}
function addRow(name,values){if(!CONFIG.tabs.includes(name)||CONFIG.readonlyTabs.includes(name))throw Error('Archivio in sola lettura');const sh=SpreadsheetApp.openById(CONFIG.spreadsheetId).getSheetByName(name),m=detect_(sh),locked=formulaCols_(sh,m),row=sh.getLastRow()+1,out=new Array(m.headers.length).fill('');Object.keys(values).forEach(k=>{const c=m.headers.indexOf(k);if(c<0)throw Error('Colonna sconosciuta');if(locked[c])throw Error('La colonna '+k+' è calcolata e protetta');out[c]=value_(values[k]);});sh.getRange(row,1,1,out.length).setValues([out]);SpreadsheetApp.flush();return{ok:true};}
function detect_(sh){const nr=Math.min(20,Math.max(1,sh.getLastRow())),nc=Math.min(30,Math.max(1,sh.getLastColumn())),a=sh.getRange(1,1,nr,nc).getDisplayValues();let best=0,idx=0;a.forEach((r,i)=>{const n=r.filter(x=>String(x).trim()).length;if(n>best){best=n;idx=i+1;}});return{headerRow:best>=2?idx:0,headers:best>=2?sh.getRange(idx,1,1,sh.getLastColumn()).getDisplayValues()[0].map((x,i)=>String(x).trim()||'Colonna '+(i+1)):[]};}
function formulaCols_(sh,m){const n=Math.max(1,Math.min(500,sh.getLastRow()-m.headerRow)),f=sh.getRange(m.headerRow+1,1,n,sh.getLastColumn()).getFormulas();return m.headers.map((_,c)=>f.some(r=>!!r[c]));}
function value_(v){if(v===null||v===undefined||v==='')return'';if(typeof v==='string'&&/^(true|false)$/i.test(v.trim()))return/^true$/i.test(v.trim());return typeof v==='string'?v.trim():v;}